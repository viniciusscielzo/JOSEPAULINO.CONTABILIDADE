{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://viniciusscielzo.vercel.app https://michael-smith-portfolio.vinicius-scielzo1.chatgpt.site"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/psicologos-original/politica-privacidade.html",
      "destination": "/psicologos-original/politica-privacidade"
    },
    {
      "source": "/psicologos-original/index.html",
      "destination": "/psicologos-original"
    },
    {
      "source": "/psicologos/politica-privacidade.html",
      "destination": "/psicologos/politica-privacidade"
    },
    {
      "source": "/psicologos/index.html",
      "destination": "/psicologos"
    }
  ]
}
